# AIDSS backend configuration — copy to .env and adjust.
# Every value here matches the default in api/core/config.py.

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=dev-secret-change-in-production
AUTH_BYPASS=true

# ── Infrastructure ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://aidss:aidss@localhost:5432/aidss


# ══════════════════════════════════════════════════════════════════════════════
#  IDX MARKET DATA
# ══════════════════════════════════════════════════════════════════════════════
#
# WHAT YOU GET WITH THE DEFAULT (vendor=yahoo)
#
#   Real IDX prices.       Actual traded prices for .JK instruments, not
#                          simulated. Verified: 15/15 of the tracked universe
#                          plus ^JKSE return live quotes.
#
#   Delayed by 10 minutes. Yahoo self-declares `exchangeDataDelayedBy: 10` and
#                          labels the payload "Delayed Quote". The API surfaces
#                          that delay on every response (`delaySeconds`,
#                          `dataAsOf`, `isDelayed`) so the UI states what it is
#                          showing. It is real data. It is NOT real time.
#
# GETTING TRUE REAL TIME
#
#   Real-time IDX data is licensed. The options are:
#     • IDX PDPS / IDX DataFeed  — direct from the exchange, commercial licence
#     • An authorised data vendor — Refinitiv, Bloomberg, Quandl-style resellers
#     • A broker API             — Stockbit, IPOT, Mirae and others expose
#                                  real-time data to their own account holders
#
#   To wire one in: implement MarketDataProvider in ingestor/providers/,
#   register it in ingestor/providers/__init__.py::get_provider(), then set
#   IDX_FEED_VENDOR to its name. Nothing downstream changes, and the delay the
#   UI reports drops to whatever the new feed declares.
#
IDX_FEED_VENDOR=yahoo
IDX_FEED_API_KEY=
IDX_FEED_WS_URL=

# Poll cadence, seconds. IDX trades 09:00–16:00 WIB on weekdays; outside those
# hours prices do not move, so the closed-market interval is deliberately long.
# Do not lower the open interval below ~30s: the feed is 10 minutes delayed, so
# faster polling re-fetches identical data and provokes rate limiting.
MARKET_POLL_INTERVAL_OPEN_SEC=60
MARKET_POLL_INTERVAL_CLOSED_SEC=900
MARKET_STALE_TOLERANCE_SEC=300

# Daily OHLCV backfill. Must exceed TA_GAP_LOOKBACK_DAYS or gap-fill
# probability runs on a truncated sample.
OHLCV_BACKFILL_DAYS=400
OHLCV_VENDOR_SUFFIX=.JK


# ══════════════════════════════════════════════════════════════════════════════
#  FEATURE FLAGS
# ══════════════════════════════════════════════════════════════════════════════
#
# Market data defaults to REAL. The rest stay mocked because they depend on
# artefacts absent from a fresh checkout: a trained LightGBM model, a fitted
# GARCH, and a real portfolio ledger. Turning them on without those produces
# errors rather than better numbers.
#
USE_MOCK_MARKET=false
USE_MOCK_SIGNALS=true
USE_MOCK_RISK=true
USE_MOCK_PORTFOLIO=true

# Broker summary. IDX publishes broker summary END OF DAY — there is no free
# real-time source, so the worker runs once after the close. With mock=true the
# broker codes and lots are SIMULATED; they name real securities firms, and the
# UI labels them as simulated. Do not remove that label.
USE_MOCK_BROKSUM=true
BROKSUM_SCRAPE_SOURCE=idx
PROXY_POOL_API_KEY=

# ── Technical analysis ────────────────────────────────────────────────────────
TA_SR_METHOD=fractal
TA_GAP_THRESHOLD_PCT=1.0
TA_GAP_LOOKBACK_DAYS=252
TA_MAX_STOP_LOSS_PCT=8.0
TA_MIN_STOP_LOSS_PCT=1.5

# ── Claude API (Phase 7 advisor) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ── Observability ─────────────────────────────────────────────────────────────
METRICS_ENABLED=true
SENTRY_DSN=
